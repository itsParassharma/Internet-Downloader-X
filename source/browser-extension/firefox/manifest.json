{
  "manifest_version": 3,
  "name": "IDX – Internet Downloader X",
  "version": "0.1.0",
  "description": "Send links to IDX and optionally handle new browser downloads automatically.",
  "permissions": ["nativeMessaging", "contextMenus", "activeTab", "storage"],
  "optional_permissions": ["downloads"],
  "incognito": "not_allowed",
  "icons": { "16": "icons/idx-16.png", "32": "icons/idx-32.png", "48": "icons/idx-48.png", "128": "icons/idx-128.png" },
  "background": { "scripts": ["native.js", "background.js"] },
  "action": { "default_title": "Download with IDX", "default_popup": "popup.html", "default_icon": { "16": "icons/idx-16.png", "32": "icons/idx-32.png" } },
  "browser_specific_settings": {
    "gecko": {
      "id": "idx-downloader@idx.local",
      "strict_min_version": "109.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
